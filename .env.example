# --- Database -----------------------------------------------------------------
# Any Postgres connection string works. On Vercel, add Neon from
# Storage → Create Database and DATABASE_URL is injected automatically.
# The app also accepts POSTGRES_URL, DATABASE_URL_UNPOOLED and
# POSTGRES_URL_NON_POOLING as fallbacks.
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# --- Movie metadata (TMDB) ----------------------------------------------------
# Free key from https://www.themoviedb.org/settings/api
# Either the v3 "API Key" or the v4 "API Read Access Token" works here.
TMDB_API_KEY="your-tmdb-key"
